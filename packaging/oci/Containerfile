FROM ubuntu:24.04

ARG SOURCE_DATE_EPOCH=0
ARG TORKITTEN_REVISION=unknown

LABEL org.opencontainers.image.title="Torkitten" \
      org.opencontainers.image.description="Persistent self-hosted onion gateway" \
      org.opencontainers.image.version="0.1.0" \
      org.opencontainers.image.revision="${TORKITTEN_REVISION}" \
      org.opencontainers.image.source="https://github.com/openresearchtools/torkitten" \
      org.opencontainers.image.licenses="MIT"

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        libcap2 \
        libevent-2.1-7t64 \
        liblzma5 \
        libseccomp2 \
        libssl3t64 \
        libsystemd0 \
        libzstd1 \
        zlib1g \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 torkitten \
    && useradd --uid 10001 --gid torkitten --home-dir /var/lib/torkitten \
        --shell /usr/sbin/nologin torkitten

COPY --chown=0:0 bin/torkittend /opt/torkitten/bin/torkittend
COPY --chown=0:0 bin/torkittenctl /opt/torkitten/bin/torkittenctl
COPY --chown=0:0 bin/tor /opt/torkitten/bin/tor
COPY --chown=0:0 bin/caddy /opt/torkitten/bin/caddy
COPY --chown=0:0 licenses/torkitten/LICENSE /usr/share/doc/torkitten/LICENSE
COPY --chown=0:0 licenses/tor /usr/share/doc/torkitten/third-party/tor
COPY --chown=0:0 licenses/caddy /usr/share/doc/torkitten/third-party/caddy

RUN chmod 0755 /opt/torkitten/bin/torkittend /opt/torkitten/bin/torkittenctl \
        /opt/torkitten/bin/tor /opt/torkitten/bin/caddy \
    && install -d -m 0700 -o torkitten -g torkitten /var/lib/torkitten

USER 10001:10001
VOLUME ["/var/lib/torkitten"]
EXPOSE 12755
STOPSIGNAL SIGTERM

ENTRYPOINT ["/opt/torkitten/bin/torkittend"]
CMD ["--state-dir", "/var/lib/torkitten", "--runtime-dir", "/tmp/torkitten", "--tor-binary", "/opt/torkitten/bin/tor", "--caddy-binary", "/opt/torkitten/bin/caddy", "--admin-listen", "0.0.0.0:12755", "--admin-origin", "http://localhost:12755", "--service-manager", "direct"]
