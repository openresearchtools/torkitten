[Unit]
Description=Torkitten managed Caddy process
After=torkitten-tor.service
ConditionPathExists=/var/lib/torkitten/caddy/caddy.json
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=exec
User=torkitten-caddy
Group=torkitten-caddy
SupplementaryGroups=torkitten-publish
Environment=HOME=/var/lib/torkitten/caddy/home
Environment=XDG_DATA_HOME=/var/lib/torkitten/caddy/data
Environment=XDG_CONFIG_HOME=/var/lib/torkitten/caddy/config
ExecStart=/usr/lib/torkitten/caddy run --config /var/lib/torkitten/caddy/caddy.json
ExecReload=/usr/lib/torkitten/caddy reload --config /var/lib/torkitten/caddy/caddy.json --address unix//run/torkitten/caddy/admin.sock
Restart=on-failure
RestartSec=5s
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/torkitten/caddy /run/torkitten/caddy
ReadOnlyPaths=/run/torkitten/web
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
LockPersonality=yes
MemoryDenyWriteExecute=yes
