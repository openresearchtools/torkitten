#include <tunables/global>

profile torkittend /usr/bin/torkittend flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  /usr/bin/torkittend mr,
  /usr/bin/systemctl rix,
  /usr/lib/torkitten/tor rix,
  /usr/lib/torkitten/caddy rix,
  /etc/ssl/certs/** r,
  /etc/machine-id r,
  @{PROC}/@{pid}/cgroup r,
  @{PROC}/@{pid}/cpuset r,
  @{PROC}/@{pid}/mountinfo r,
  @{PROC}/@{pid}/stat r,
  /proc/sys/net/core/somaxconn r,
  /proc/sys/kernel/random/uuid r,
  /sys/fs/cgroup/**/cpu.max r,
  /sys/fs/cgroup/**/memory.max r,
  /sys/devices/virtual/dmi/id/product_uuid r,
  /var/lib/torkitten/ rw,
  /var/lib/torkitten/** rwk,
  /run/dbus/system_bus_socket rw,
  /run/systemd/private rw,
  /run/torkitten/ rw,
  /run/torkitten/** rwk,

  network inet stream,
  network inet6 stream,
  unix,
  dbus (send)
    bus=system
    peer=(name=org.freedesktop.systemd1),
  dbus (receive)
    bus=system
    path=/org/freedesktop/systemd1
    interface=org.freedesktop.systemd1.Manager
    member=JobRemoved,
}

profile torkitten-tor /usr/lib/torkitten/tor flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  /usr/lib/torkitten/tor mr,
  /etc/ssl/certs/** r,
  /var/lib/torkitten/tor/ rw,
  /var/lib/torkitten/tor/** rwk,
  /run/torkitten/ rw,
  /run/torkitten/** rwk,

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  unix,
}

profile torkitten-caddy /usr/lib/torkitten/caddy flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  /usr/lib/torkitten/caddy mr,
  /etc/ssl/certs/** r,
  /etc/machine-id r,
  @{PROC}/@{pid}/cgroup r,
  @{PROC}/@{pid}/cpuset r,
  @{PROC}/@{pid}/mountinfo r,
  @{PROC}/@{pid}/stat r,
  /proc/sys/net/core/somaxconn r,
  /sys/fs/cgroup/**/cpu.max r,
  /sys/fs/cgroup/**/memory.max r,
  /sys/devices/virtual/dmi/id/product_uuid r,
  /var/lib/torkitten/caddy/ rw,
  /var/lib/torkitten/caddy/** rwk,
  /run/torkitten/ rw,
  /run/torkitten/** rwk,

  network inet stream,
  network inet6 stream,
  unix,
}
