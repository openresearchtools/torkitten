[Unit]
Description=Torkitten managed C Tor process
After=network-online.target torkittend.service
Wants=network-online.target
ConditionPathExists=/var/lib/torkitten/tor/torrc
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=exec
User=torkitten-tor
Group=torkitten-tor
SupplementaryGroups=torkitten-publish
ExecStartPre=/usr/lib/torkitten/torkitten-tor-prepare
ExecStart=/usr/lib/torkitten/tor -f /var/lib/torkitten/tor/torrc
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=30s
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/var/lib/torkitten/tor/torrc /var/lib/torkitten/tor/sites
ReadOnlyPaths=/run/torkitten/caddy
ReadWritePaths=/var/lib/torkitten/tor/data /var/lib/torkitten/tor/hidden-services /run/torkitten/tor
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
LockPersonality=yes
